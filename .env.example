# =========================================================
# Tournamax environment — COPY THIS FILE.
#
# Put your secrets in `.env.local` (recommended — Next.js loads it
# after `.env`, so it wins) or in real environment variables in
# production. Never commit either file.
#
#   cp .env.example .env.local
#
# Only DATABASE_URL is required to boot the app; everything below it
# is optional and the app degrades gracefully if it is missing.
# =========================================================

# --- Primary app database ---
# PostgreSQL (default runtime):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- App ---
APP_BASE_URL=http://localhost:3000
APP_NAME=Tournamax

# --- Sessions ---
SESSION_TTL_DAYS=14
ADMIN_SESSION_TTL_HOURS=12

# --- Uploads (files land in ./storage, outside the web root) ---
APK_MAX_MB=150
LOGO_MAX_MB=2
PROOF_MAX_MB=5

# --- Download policy: days after expiry that prepared APKs stay downloadable ---
DOWNLOAD_GRACE_DAYS=7

# =========================================================
# EMAIL — Gmail SMTP with an App Password
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account → Security → App passwords → generate one.
#   3. Put the 16-character password in SMTP_PASS below.
# =========================================================
EMAIL_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="Tournamax <you@gmail.com>"
MAIL_FROM_ADDRESS=you@gmail.com
SUPPORT_EMAIL=you@gmail.com

# =========================================================
# PRODUCTION MySQL (alchemyCP / alchosting)
# Used by the admin System Status page and deploy/mysql-schema.sql
# =========================================================
MYSQL_ENABLED=1
MYSQL_HOST=sq1301.alchosting.xyz
MYSQL_PORT=3306
MYSQL_DATABASE=your_db_name
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_SSL=false
